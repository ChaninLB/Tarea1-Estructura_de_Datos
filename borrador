# CONTROLADOR DE PAGOS
# =====================================================================
class PagoController(CrudBase):

    def __init__(self, ventas, archivo="data/pagos.json"):
        # El pago USA al controlador de ventas para buscar comprobantes y totales
        self.ventas = ventas
        self.gestor = GestorJSON(archivo)

        self.lista = []
        for datos in self.gestor.leer():
            self.lista.append(Pago.desde_diccionario(datos))

    def guardar(self):
        datos = []
        for pago in self.lista:
            datos.append(pago.a_diccionario())
        self.gestor.guardar(datos)

    def total_a_pagar(self, venta):
        # El total con IVA de la venta (el mismo número que muestra el comprobante)
        return Producto.con_iva(venta.calcular_total())

    def ventas_pagadas(self):
        # CONJUNTO con los venta_id que ya tienen un pago registrado
        return {p.venta_id for p in self.lista}

    def esta_pagada(self, venta_id):
        return venta_id in self.ventas_pagadas()

    def pago_de_venta(self, venta_id):
        for pago in self.lista:
            if pago.venta_id == venta_id:
                return pago
        return None

    def validar(self, datos):
        try:
            venta_id = int(datos.get("venta_id", 0))
        except (TypeError, ValueError):
            return "El id de la venta debe ser un número entero"

        venta = self.ventas.obtener(venta_id)
        if venta is None:
            return f"No existe una venta con id {venta_id}"

        if self.esta_pagada(venta_id):
            return f"La venta #{venta_id} ya se encuentra pagada"

        metodo = str(datos.get("metodo", "")).strip().lower()
        if not Pago.es_metodo_valido(metodo):
            return f"Método de pago inválido. Elija entre: {', '.join(Pago.METODOS)}"

        total = self.total_a_pagar(venta)
        recibido = datos.get("recibido", "")

        if metodo == "efectivo":
            try:
                recibido_num = float(recibido)
            except (TypeError, ValueError):
                return "Debe ingresar un monto recibido válido"
            
            if recibido_num < total:
                faltante = round(total - recibido_num, 2)
                return f"Monto insuficiente: faltan ${faltante:.2f}"
        
        return None

    def leer(self):
        return self.lista

    def obtener(self, id_pago):
        for pago in self.lista:
            if pago.id == id_pago:
                return pago
        return None

    def buscar(self, texto):
        texto = texto.strip().lower()
        encontrados = []
        if texto == "":
            return encontrados

        for pago in self.lista:
            if texto in pago.fecha or texto in pago.metodo:
                encontrados.append(pago)
        return encontrados

    def siguiente(self):
        mayor = 0
        for pago in self.lista:
            if pago.id > mayor:
                mayor = pago.id
        return mayor + 1

    def crear(self, datos):
        error = self.validar(datos)
        if error:
            return False, error

        venta_id = int(datos["venta_id"])
        venta = self.ventas.obtener(venta_id)
        metodo = str(datos["metodo"]).strip().lower()
        total = self.total_a_pagar(venta)

        recibido = total if metodo != "efectivo" else float(datos["recibido"])

        pago = Pago(self.siguiente(), venta_id, total, metodo, recibido)
        self.lista.append(pago)
        self.guardar()
        
        cambio_txt = f" · cambio ${pago.calcular_cambio():.2f}" if metodo == "efectivo" else ""
        return True, f"Pago #{pago.id} registrado por ${pago.monto:.2f}{cambio_txt}"

    def actualizar(self, id_pago, datos):
        return False, "Los pagos registrados no se pueden modificar"

    def eliminar(self, id_pago):
        return False, "Los pagos registrados no se pueden eliminar"

    # --- propio de pagos ---
    def recibo(self, id_pago):
        pago = self.obtener(id_pago)
        if pago is None:
            return None

        texto = f"RECIBO DE PAGO #{pago.id}   fecha: {pago.fecha}\n"
        texto += f"Venta   : #{pago.venta_id}\n"
        texto += f"Método  : {pago.metodo}\n"
        texto += "-" * 42 + "\n"
        texto += f"TOTAL   : ${pago.monto:.2f}\n"
        texto += f"Recibido: ${pago.recibido:.2f}\n"
        texto += f"Cambio  : ${pago.calcular_cambio():.2f}\n"
        texto += "Estado  : PAGADA"
        return texto

    def ventas_pendientes(self):
        pagadas = self.ventas_pagadas()
        pendientes = []
        for venta in self.ventas.leer():
            if venta.id not in pagadas:
                pendientes.append(venta)
        return pendientes

    def total_cobrado(self):
        total = 0
        for pago in self.lista:
            total += pago.monto
        return round(total, 2)

