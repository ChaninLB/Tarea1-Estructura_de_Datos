def realizar_pago():
    imprimir_titulo("REALIZAR PAGO")
    
    pendientes = pagos.ventas_pendientes()
    if not pendientes:
        imprimir_info("No hay ventas pendientes de pago.")
        return pausa()

    imprimir_info("Ventas pendientes:")
    mostrar_lista(pendientes)
    
    id_venta = pedir_entero("\nId de la venta / factura: ")
    if id_venta is None:
        imprimir_error("Debe ingresar un número entero válido")
        return pausa()

    comprobante = ventas.comprobante(id_venta)
    if comprobante is None:
        imprimir_error("No existe esa venta")
        return pausa()

    print()
    print(comprobante)
    print()

    if pagos.esta_pagada(id_venta):
        imprimir_info("ℹ Estado: PAGADA")
        return pausa()
    else:
        imprimir_info("ℹ Estado: PENDIENTE")

    print("\nMétodos de pago:")
    for i, metodo in enumerate(Pago.METODOS, 1):
        print(f"  {i}. {metodo}")
    
    opcion_metodo = pedir_entero("Elija una opción de método: ")
    if opcion_metodo is None or not (1 <= opcion_metodo <= len(Pago.METODOS)):
        imprimir_error("Opción de método inválida")
        return pausa()

    metodo = Pago.METODOS[opcion_metodo - 1]
    recibido = ""

    if metodo == "efectivo":
        recibido = input("Monto recibido: ").strip()

    datos = {
        "venta_id": id_venta,
        "metodo": metodo,
        "recibido": recibido
    }

    mostrar_resultado(*pagos.crear(datos))
    pausa()


def consultar_pago():
    imprimir_titulo("CONSULTAR PAGO")
    id_venta = pedir_entero("Id de la venta: ")
    if id_venta is None:
        imprimir_error("Id inválido")
        return pausa()

    comprobante = ventas.comprobante(id_venta)
    if comprobante is None:
        imprimir_error("No existe esa venta")
        return pausa()

    print()
    print(comprobante)
    print("-" * 42)

    pago = pagos.pago_de_venta(id_venta)
    if pago:
        print(pagos.recibo(pago.id))
    else:
        imprimir_info("Estado: PENDIENTE de pago")
    pausa()


def listar_pagos():
